# LLM provider: "gemini" (cloud), "ollama" (local), or "openai" (any OpenAI-compatible
# endpoint, e.g. a LiteLLM proxy in front of self-hosted vLLM models)
LLM_PROVIDER=gemini

# Gemini (Google AI Studio)
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Ollama (local)
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434

# OpenAI-compatible (e.g. LiteLLM proxy)
# OPENAI_MODEL=qwen3.6-35b-a3b
# OPENAI_BASE_URL=http://litellm.litellm.svc.cluster.local:4000/v1
# OPENAI_API_KEY=your-litellm-virtual-key-here

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
# To use a different database without editing this file:
#   python start.py --database other_db
# To see all available databases:
#   python start.py --list-databases

# Schemas train.py loads DDL from (comma-separated). Keeps training scoped to the
# schemas Vanna actually needs instead of every table in the database.
TRAIN_SCHEMAS=bronze,silver,gold

# BigQuery (optional — uncomment and set when ready)
# BIGQUERY_PROJECT_ID=your-gcp-project-id

# Server
HOST=0.0.0.0
PORT=8084
